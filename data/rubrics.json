    {
      "id": "rubric_11_iletisim_engelleri",
      "title": "İletişim Engelleri — Grup Draması Değerlendirme",
      "description": "Görev sınıfta, öğretmen rehberliğinde oluşturulan gruplarla yürütülür. Hazırlık kontrolü süreç içindir ve puana dâhil değildir; nihai drama performansı 100 puan üzerinden değerlendirilir.",
      "grade": 11,
      "targetTask": "İletişim Engelleri",
      "criteria": [
        {
          "id": "rubric_11_iletisim_engelleri_criterion_01",
          "title": "Konu, amaç ve iletişim engeliyle uyum",
          "description": "Seçilen durum sözlü iletişim engeliyle doğrudan ilişkilidir; canlandırmanın amacı ve kapsamı anlaşılırdır.",
          "maxPoints": 10,
          "orderIndex": 0
        },
        {
          "id": "rubric_11_iletisim_engelleri_criterion_02",
          "title": "İçeriğin doğruluğu ve çözümün gösterilmesi",
          "description": "İletişim engeli, nedeni ve etkisi doğru yansıtılır; uygun çözüm yolu canlandırmada görünür hâle getirilir.",
          "maxPoints": 20,
          "orderIndex": 1
        },
        {
          "id": "rubric_11_iletisim_engelleri_criterion_03",
          "title": "Planlama ve hazırlık",
          "description": "Araştırma, hedef kitle, süre, yöntem/strateji, araç, mekân ve teknik koşullar planlanır; taslak geri bildirimle geliştirilir.",
          "maxPoints": 15,
          "orderIndex": 2
        },
        {
          "id": "rubric_11_iletisim_engelleri_criterion_04",
          "title": "Canlandırma becerisi ve dramatik akış",
          "description": "Roller tutarlı, sahne akışı anlaşılır ve canlandırma başlangıç-gelişme-sonuç bütünlüğünde yürütülür.",
          "maxPoints": 20,
          "orderIndex": 3
        },
        {
          "id": "rubric_11_iletisim_engelleri_criterion_05",
          "title": "Sözü, Türkçeyi ve beden dilini etkili kullanma",
          "description": "Söz varlığı, diksiyon, telaffuz, vurgu-tonlama, jest-mimik ve beden dili iletiyi destekler.",
          "maxPoints": 20,
          "orderIndex": 4
        },
        {
          "id": "rubric_11_iletisim_engelleri_criterion_06",
          "title": "Grupla uyum ve izleyiciyle iletişim",
          "description": "Rol paylaşımı ve iş birliği sürdürülür; grup üyeleri birbirini tamamlar ve izleyiciyle etkileşim kurulur.",
          "maxPoints": 10,
          "orderIndex": 5
        },
        {
          "id": "rubric_11_iletisim_engelleri_criterion_07",
          "title": "Özgünlük",
          "description": "Grup, iletişim engelini hazır bir örneği taklit etmek yerine kendine özgü durum, yorum ve çözümle işler.",
          "maxPoints": 5,
          "orderIndex": 6
        }
      ],
      "groupPreparationChecklist": {
        "description": "Görev sınıfta, öğretmen rehberliğinde oluşturulan gruplarla yürütülür. Hazırlık kontrolü süreç içindir ve puana dâhil değildir; nihai drama performansı 100 puan üzerinden değerlendirilir.",
        "items": [
          "Konu ve amaç",
          "Gözlem / inceleme / araştırma",
          "Yöntem ve strateji",
          "Süre ve hedef kitle",
          "Araçlar / canlandırma biçimi",
          "Mekân / teknik / görüntü / ses",
          "İletişim engellerini giderme"
        ]
      }
    },
